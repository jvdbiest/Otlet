# SPDX-License-Identifier: AGPL-3.0-or-later
# Deployment settings only (ARCHITECTURE §20.3); everything else is set in the interface.
# Generate .env with ./configure.sh rather than copying this file by hand.

# Public name of the instance. "localhost" gives a local certificate, for tests.
OTLET_DOMAIN=localhost

# Image to run. Without a registry, `docker compose build` builds it from this repository.
OTLET_IMAGE=otlet
OTLET_VERSION=dev

# PostgreSQL passwords, random; configure.sh generates them. The superuser (POSTGRES_PASSWORD)
# is used by the provision and backup services only; the application connects as otlet_app,
# migrations as otlet_migrator (M-12).
POSTGRES_PASSWORD=
OTLET_MIGRATOR_PASSWORD=
OTLET_APP_PASSWORD=

# Published ports, if 80 and 443 are already taken on the host.
OTLET_HTTP_PORT=80
OTLET_HTTPS_PORT=443
