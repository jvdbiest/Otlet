"""Throw-away migration of the S6 upgrade scenario (C2): plays the role of version N+1.
Never copied into backend/migrations. upgrade-rollback.sh writes the head revision of version
N in place of @HEAD@ before building.

Revision: s6_next
Previous: the head of version N
"""

import sqlalchemy as sa
from alembic import op

revision = "s6_next"
down_revision = "@HEAD@"
branch_labels = None
depends_on = None


def upgrade() -> None:
    op.add_column("instance_settings", sa.Column("note", sa.Text(), nullable=True))


def downgrade() -> None:
    op.drop_column("instance_settings", "note")
