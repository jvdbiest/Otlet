# SPDX-License-Identifier: AGPL-3.0-or-later
# Single multi-role image (TC-13): `otlet api`, `otlet worker`, `otlet scheduler`.
# Build from the repository root:
#   docker build -f deploy/Containerfile -t otlet:dev .
# Node.js is used only to build the interface; the final image has no Node.js (TC-03).

ARG PYTHON_IMAGE=python:3.13-slim-trixie
ARG NODE_IMAGE=node:24-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.0

FROM ${UV_IMAGE} AS uv

# --- Interface: static files ---------------------------------------------------
FROM ${NODE_IMAGE} AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# --- Back-end: virtual environment from the exact lock ------------------------
FROM ${PYTHON_IMAGE} AS backend
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/otlet/venv
WORKDIR /src
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY backend/src ./src
RUN uv sync --locked --no-dev --no-editable

# --- Runtime -----------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime
LABEL org.opencontainers.image.title="Otlet" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/jvdbiest/Otlet"
RUN groupadd --system --gid 10001 otlet \
    && useradd --system --uid 10001 --gid otlet --no-create-home --shell /usr/sbin/nologin otlet
COPY --from=backend /opt/otlet/venv /opt/otlet/venv
COPY --from=frontend /src/dist /opt/otlet/ui
ENV PATH=/opt/otlet/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OTLET_UI_DIR=/opt/otlet/ui \
    OTLET_RUN_DIR=/tmp/otlet
USER otlet:otlet
EXPOSE 8000
ENTRYPOINT ["otlet"]
CMD ["api"]
