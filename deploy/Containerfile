# SPDX-License-Identifier: AGPL-3.0-or-later
# Single multi-role image (TC-13): `otlet api`, `otlet worker`, `otlet scheduler`,
# `otlet migrate`.
# Build from the repository root:
#   docker build -f deploy/Containerfile -t otlet:dev .
# Node.js is used only to build the interface; the final image has no Node.js (TC-03).

ARG PYTHON_IMAGE=python:3.13-slim-trixie
ARG NODE_IMAGE=node:24-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.0

FROM ${UV_IMAGE} AS uv

# --- Interface: static files ---------------------------------------------------
FROM ${NODE_IMAGE} AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# --- Back-end: virtual environment from the exact lock ------------------------
FROM ${PYTHON_IMAGE} AS backend
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/otlet/venv
WORKDIR /src
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY backend/src ./src
RUN uv sync --locked --no-dev --no-editable

# --- Runtime -----------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime
LABEL org.opencontainers.image.title="Otlet" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/jvdbiest/Otlet"
# Pango and fonts for the PDF exports (WeasyPrint, X03c): metric-compatible stand-ins for Arial,
# Times New Roman, Courier New (Liberation), Calibri (Carlito) and Cambria (Caladea).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
        fonts-dejavu-core fonts-liberation2 fonts-crosextra-carlito fonts-crosextra-caladea \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 10001 otlet \
    && useradd --system --uid 10001 --gid otlet --no-create-home --shell /usr/sbin/nologin otlet \
    && install -d -o otlet -g otlet -m 0750 /var/lib/otlet/files
COPY --from=backend /opt/otlet/venv /opt/otlet/venv
COPY --from=frontend /src/dist /opt/otlet/ui
COPY backend/migrations /opt/otlet/migrations
ENV PATH=/opt/otlet/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OTLET_UI_DIR=/opt/otlet/ui \
    OTLET_MIGRATIONS_DIR=/opt/otlet/migrations \
    OTLET_RUN_DIR=/tmp/otlet \
    OTLET_FILES_DIR=/var/lib/otlet/files
# The image fails to build if WeasyPrint cannot find Pango.
RUN python -c "import weasyprint"
USER otlet:otlet
EXPOSE 8000
ENTRYPOINT ["otlet"]
CMD ["api"]
