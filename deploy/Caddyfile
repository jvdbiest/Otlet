# Reverse proxy with automatic TLS (TECH_CHOICES §19.2). The application relies on no
# Caddy-specific feature: any proxy that forwards to api:8000 works.
# With OTLET_DOMAIN=localhost, Caddy issues a certificate from its own local authority;
# otherwise from Let's Encrypt, which needs no account e-mail.

{
	# Clients send no SNI when the instance is reached by IP address (local network,
	# no domain name): without a default, Caddy refuses the TLS handshake.
	default_sni {$OTLET_DOMAIN}
}

{$OTLET_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy api:8000
}
