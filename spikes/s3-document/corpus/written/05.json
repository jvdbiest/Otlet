        "id": "b1",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Le rapport publié cette semaine éclaire la numérisation des archives communales sous un jour nouveau."
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "id": "b2",
        "origine": "humain",
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Ce que prévoit le projet sur numérique"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b3",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Selon les documents consultés, "
        },
        {
          "type": "text",
          "text": "le coût total reste à confirmer",
          "marks": [
            {
              "type": "source_ref",
              "attrs": {
                "source": "S1"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": ". "
        },
        {
          "type": "text",
          "text": "L’opposition salue l’intention mais s’interroge sur le coût d’entretien à long terme."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b4",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "La "
        },
        {
          "type": "text",
          "text": "fiche détaillée",
          "marks": [
            {
              "type": "link",
              "attrs": {
                "href": "https://exemple.org/numérique/fiche-05"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": " est disponible en ligne, et "
        },
        {
          "type": "text",
          "text": "plusieurs points restent ouverts",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "citation",
      "attrs": {
        "id": "b5",
        "origine": "humain",
        "source": "S2"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Les chiffres sont encourageants, mais il faut rester prudent."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "id": "b6",
        "origine": "humain",
        "level": 3
      },
      "content": [
        {
          "type": "text",
          "text": "Les prochaines étapes"
        }
      ]
    },
    {
      "type": "bullet_list",
      "attrs": {
        "id": "b7",
        "origine": "humain"
      },
      "content": [
        {
          "type": "list_item",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "un appel à projets ouvert aux associations"
                }
              ]
            }
          ]
        },
        {
          "type": "list_item",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "une consultation en ligne de six semaines"
                }
              ]
            }
          ]
        },
        {
          "type": "list_item",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "un rapport annuel public"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b8",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Le calendrier prévoit une première phase dès le printemps, puis une évaluation à l’automne.",
          "marks": [
            {
              "type": "italic"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "id": "b9",
        "origine": "humain",
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Contexte"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b10",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Le calendrier prévoit une première phase dès le printemps, puis une évaluation à l’automne."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b11",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Les montants annoncés restent provisoires tant que les subsides régionaux ne sont pas confirmés."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b12",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Plusieurs associations demandent que les données de suivi soient rendues publiques."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b13",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "L’opposition salue l’intention mais s’interroge sur le coût d’entretien à long terme."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b14",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Un comité de suivi réunira élus, agents et riverains deux fois par an."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "id": "b15",
        "origine": "humain"
      },
      "content": [
        {
          "type": "text",
          "text": "Les premiers retours d’expérience venus d’autres communes sont jugés encourageants."
        }
      ]
    }
  ]
