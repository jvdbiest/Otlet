        {
          "type": "text",
          "text": "plusieurs points restent ouverts",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "citation",
      "attrs": {
