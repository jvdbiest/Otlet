          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "id": "b6",
        "origine": "humain",
        "level": 3
      },
      "content": [
        {
          "type": "text",
          "text": "Les prochaines étapes"
        }
      ]
